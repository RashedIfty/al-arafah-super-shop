# What Cloudflare must not publish from the repository root.
# The site needs only the pages, assets/, images/, fonts-woff/ and the
# few files beside them; everything below is tooling or source.

# Installed by Cloudflare's build before deploying; one file is 128 MB.
node_modules
.wrangler
.git
.github

# Source maps: build.js still writes them into assets/ so errors can be
# traced here, but the site does not publish them.
*.map

# Source: the pages load only the built files in assets/.
src
worker
api
supabase
docs
public

# Tooling and notes
build.js
package.json
package-lock.json
wrangler.jsonc
README.md
.gitignore
.assetsignore

# Hidden files and folders (local tools and settings) are never published.
.*

# Code map made by graphify (local only)
graphify-out
